{
  "name": "flash-guard",
  "version": "1.0.0",
  "private": true,
  "description": "Offline fintech apps, API, and DB for QE students.",
  "scripts": {
    "stack:up": "npm run stack:up:containers && npm --prefix mobile run start",
    "stack:up:containers": "docker compose up -d --build && node scripts/seed-after-up.mjs",
    "stack:up:local": "docker compose stop api && docker compose up -d --build --no-deps web mobile && npm run db:init-local && npm run api:start:windows-auth",
    "api:start:windows-auth": "node scripts/start-api-windows-auth.mjs",
    "db:init-local": "node scripts/init-local-db.mjs",
    "stack:down": "docker compose down -v",
    "stack:logs": "docker compose logs -f",
    "db:reset-seed": "docker compose --profile seed run --rm app-seed",
    "api:health": "curl http://localhost:4000/health",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.10",
    "webdriverio": "^9.33.1"
  },
  "dependencies": {
    "mssql": "^12.8.1"
  }
}
